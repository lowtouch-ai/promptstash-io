{
  "manifest_version": 3,
  "name": "PromptStash - ChatGPT, Grok & Gemini veo AI Prompt Manager by lowtouch.ai",
  "version": "3.1.0",
  "description": "Organize & deploy AI prompts across ChatGPT, Gemini, Grok, Perplexity, Copilot, Google AI Studio, and DeepSeek. Create stunning visuals with Veo 3 and Flow.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://labs.google/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*",
    "https://aistudio.google.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://labs.google/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "styles.css",
        "sprite.svg",
        "bootstrap.bundle.min.js",
        "icon48.png"
      ],
      "matches": [
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://labs.google/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://aistudio.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}